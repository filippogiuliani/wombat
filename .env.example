# ===== Wombat – configuration =====
WOMBAT_URL=https://wombat.example.com
TZ=Europe/Rome
WOMBAT_COOKIE_SECURE=1
WOMBAT_PROXY=1

# Sign-in: Pocket ID. Callback URL to register: <WOMBAT_URL>/api/oidc/pocketid/callback
WOMBAT_OIDC=pocketid
WOMBAT_OIDC_POCKETID_ISSUER=https://id.example.com
WOMBAT_OIDC_POCKETID_ID=
WOMBAT_OIDC_POCKETID_SECRET=
WOMBAT_OIDC_POCKETID_NAME=Pocket ID
# Password sign-in: only for a first try before Pocket ID is set up. 0 in production.
WOMBAT_PASSWORD_LOGIN=0
# closed (default): only the very first person creates the family; the others are added by an admin
WOMBAT_SIGNUP=closed

# The connected apps. Key: `docker exec wombat python manage.py new-key`, the same in the app's *_HUB_KEY
WOMBAT_APPS=kooka,wallaby,pelican,quokka
WOMBAT_APP_KOOKA_URL=https://kooka.example.com
WOMBAT_APP_KOOKA_INTERNAL_URL=
WOMBAT_APP_KOOKA_KEY=
WOMBAT_APP_WALLABY_URL=https://wallaby.example.com
WOMBAT_APP_WALLABY_INTERNAL_URL=
WOMBAT_APP_WALLABY_KEY=
WOMBAT_APP_PELICAN_URL=https://pelican.example.com
WOMBAT_APP_PELICAN_INTERNAL_URL=
WOMBAT_APP_PELICAN_KEY=
# Quokka (the webmail) only asks: who signed in with Pocket ID, Kooka and Pelican on their behalf (QUOKKA_HUB_KEY there)
WOMBAT_APP_QUOKKA_URL=https://mail.example.com
WOMBAT_APP_QUOKKA_KEY=

# Email (address confirmation). Without SMTP emails are only logged.
WOMBAT_SMTP_HOST=
WOMBAT_SMTP_PORT=587
WOMBAT_SMTP_USER=
WOMBAT_SMTP_PASSWORD=
WOMBAT_MAIL_FROM=Wombat <noreply@example.com>
WOMBAT_BACKUP_KEEP=30
