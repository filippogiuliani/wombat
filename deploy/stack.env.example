# ===== Family apps stack – variables (Portainer: Environment variables → Load from .env file) =====
# Never commit the filled-in copy: it holds secrets.

TZ=Europe/Rome
# Folder of the host holding the data of the four apps (wombat/, kooka/, wallaby/, pelican/ are created inside)
DATA_ROOT=/srv/family

# Public addresses (HTTPS, through your reverse proxy) and the host ports it forwards to
WOMBAT_URL=https://wombat.example.com
KOOKA_URL=https://kooka.example.com
WALLABY_URL=https://wallaby.example.com
PELICAN_URL=https://pelican.example.com
WOMBAT_PORT=3004
KOOKA_PORT=3001
WALLABY_PORT=3000
PELICAN_PORT=3002

# Pocket ID: one OIDC client per app. Callback URL of each: <APP_URL>/api/oidc/pocketid/callback
POCKETID_ISSUER=https://id.example.com
WOMBAT_OIDC_ID=
WOMBAT_OIDC_SECRET=
KOOKA_OIDC_ID=
KOOKA_OIDC_SECRET=
WALLABY_OIDC_ID=
WALLABY_OIDC_SECRET=
PELICAN_OIDC_ID=
PELICAN_OIDC_SECRET=

# Keys between Wombat and each app (different from each other). Make each with:
#   python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
KOOKA_HUB_KEY=
WALLABY_HUB_KEY=
PELICAN_HUB_KEY=
# Quokka (the webmail, its own stack): its address and key (QUOKKA_HUB_KEY in Quokka's stack too)
QUOKKA_URL=
QUOKKA_HUB_KEY=

# Email sent by the apps (address confirmation, reminders, Pelican import summaries)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM_ADDRESS=noreply@example.com
KOOKA_REMINDER_HOUR=8

# Pelican import by email (leave empty to turn it off)
PELICAN_INBOX_ADDRESS=
PELICAN_IMAP_HOST=
PELICAN_IMAP_PORT=993
PELICAN_IMAP_USER=
PELICAN_IMAP_PASSWORD=
PELICAN_IMAP_DONE_FOLDER=
